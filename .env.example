# Variáveis de ambiente da loja "Ju, imprime pra mim?" (lista de referência, sem valores reais).
# Na Hostinger elas ficam no painel do app Node.js → Variáveis de ambiente (salvar com reimplantação); o servidor NÃO lê
# arquivos .env. Nunca coloque valores reais neste arquivo nem no Git. Detalhes de cada grupo:
# HOSTINGER-SETUP.md, MERCADOPAGO-SETUP.md, NFE-SETUP.md, FRETE-SETUP.md, BLING-RESILIENCIA.md e SOCIAL-LOGIN.md.

# ── Site ──────────────────────────────────────────────────────────────────────────────────────────────────────
APP_ENV=preview                      # "production" só na loja de verdade
SITE_URL=https://juimprimepramim.com.br   # endereço público, sem barra no fim (base dos links e dos retornos de login)

# ── Banco (MySQL) ─────────────────────────────────────────────────────────────────────────────────────────────
DATABASE_URL=                        # ou as quatro abaixo
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=                         # secreta

# ── Segredos do servidor ──────────────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=                         # secreta: assina sessões, códigos e o "state" do login com Google/Apple
DATA_KEY=                            # secreta: criptografia de CPF e telefone (guardar cópia segura)
INDEX_KEY=                           # secreta: índice cego do CPF
CRON_SECRET=                         # secreta, 24+ caracteres: protege /api/fila/rodar

# ── Painel da Ju ──────────────────────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=                      # secreta, 12+ caracteres

# ── E-mails (Resend) ──────────────────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                      # secreta
MAIL_FROM="Ju, imprime pra mim? <pedidos@juimprimepramim.com.br>"
MAIL_REPLY_TO=
ORDER_NOTIFY_EMAIL=                  # e-mail da Ju que recebe cada pedido pago
CONTACT_EMAIL=                       # opcional: para onde vai o formulário de contato

# ── Mercado Pago ──────────────────────────────────────────────────────────────────────────────────────────────
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=                     # secreta
MP_WEBHOOK_SECRET=                   # secreta
MP_MODE=                             # "live" só depois do checklist do MERCADOPAGO-SETUP.md

# ── Nota fiscal (Bling) ───────────────────────────────────────────────────────────────────────────────────────
NFE_PROVIDER=bling
NFE_ENVIRONMENT=                     # "producao" só na loja, no lançamento
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=                 # secreta

# ── Correios ──────────────────────────────────────────────────────────────────────────────────────────────────
CORREIOS_USER=
CORREIOS_CODE=                       # secreta
CORREIOS_CARD=
CORREIOS_CONTRACT=
CORREIOS_DR=
SHIP_FROM_CEP=

# ── Entrar com o Google (SOCIAL-LOGIN.md) ─────────────────────────────────────────────────────────────────────
# Console: Google Cloud → Google Auth Platform → Clientes → "Aplicativo da Web".
# URI de redirecionamento autorizado: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=                    # termina em .apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=                # secreta

# ── Entrar com a Apple (SOCIAL-LOGIN.md) ──────────────────────────────────────────────────────────────────────
# Console: Apple Developer → Certificates, Identifiers & Profiles. Return URL do Services ID: <SITE_URL>/api/auth/apple/callback
APPLE_CLIENT_ID=                     # o identificador do Services ID (ex.: br.com.juimprimepramim.web)
APPLE_TEAM_ID=                       # 10 caracteres, em Membership details
APPLE_KEY_ID=                        # 10 caracteres, da chave com "Sign in with Apple"
APPLE_PRIVATE_KEY=                   # secreta: o conteúdo do arquivo .p8 (as quebras de linha podem virar \n)

# Sem as variáveis de um provedor, o botão dele simplesmente não aparece. O endereço de retorno é sempre SITE_URL +
# /api/auth/<google|apple>/callback (não há NEXTAUTH_URL: o SITE_URL faz esse papel).
